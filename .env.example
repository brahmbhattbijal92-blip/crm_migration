# PostgreSQL server actions. Required for the credential vault and SQL-backed actions.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME?sslmode=require

# 32-byte key encoded as exactly 64 hexadecimal characters.
# Keep the same key to decrypt credentials encrypted with it.
VAULT_MASTER_KEY=REPLACE_WITH_64_HEX_CHARACTERS
VAULT_AGENT_PHONE=+15555550123

# Supabase client. Required when using Cloud storage preference.
# Use the anon/public key only; never put a service-role key in a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=client-documents
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only worker secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Optional browser-extension handoff. Set after loading extension/ unpacked in Chrome.
NEXT_PUBLIC_MIGRATION_EXTENSION_ID=YOUR_CHROME_EXTENSION_ID