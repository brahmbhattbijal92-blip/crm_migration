{
  "manifest_version": 3,
  "name": "Migration Form Assistant",
  "version": "1.0.2",
  "description": "User-initiated profile field transfer to the approved ImmiAccount portal.",
  "minimum_chrome_version": "116",
  "icons": {
    "128": "icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://online.immi.gov.au/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://online.immi.gov.au/*"],
      "js": ["content-script.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "https://crm-migration-three.vercel.app/*"
    ]
  }
}
